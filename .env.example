# Copy to .env for LOCAL development. Never commit real values.
# Running from source (npm run dev / migrate / scripts) refuses any non-local
# DB_HOST unless NODE_ENV=production is set explicitly.
NODE_ENV=development
PORT=5000

JWT_SECRET=YOUR_LONG_RANDOM_SECRET

DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=partiva

JWT_EXPIRES_IN=1d

BCRYPT_SALT_ROUNDS=10
INVITATION_TOKEN_EXPIRY_HOURS=48

ADMIN_APP_URL=http://localhost:3001

ALLOWED_ORIGINS=http://localhost:3001,http://localhost:3002

SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=notifications@partiva.tech
SMTP_PASSWORD=YOUR_EMAIL_PASSWORD
SMTP_FROM=notifications@partiva.tech
