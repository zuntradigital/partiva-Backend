# Dependencies
node_modules/

# Environment variables (real secrets) -- only .env.example is tracked
.env
.env.*
!.env.example

# Build output
dist/

# Logs
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# OS files
.DS_Store

# IDE
.vscode/
.idea/

# TypeScript
*.tsbuildinfo

# Uploaded media files (real, disk-stored assets referenced by the `media`
# table's storage_path -- the directory itself is tracked via .gitkeep so it
# always exists, but its contents are per-environment, not source.
uploads/media/*
!uploads/media/.gitkeep
# Local AI/dev-assistant tooling (never part of the app build or deployment)
.claude/
